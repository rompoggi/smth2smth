nohup: ignoring input
model:
  name: avanced_resnet50_tsm
  backbone: resnet50
  pretrained: false
  num_classes: ${num_classes}
  shift_div: 8
  shift_place: blockres
  dropout: 0.5
  drop_path_rate: 0.0
  head: mean
  head_num_heads: 4
  init_from: /Data/thomas.turkieh/smth2smth/checkpoints/track_a/ssl_trunk.pt
dataset:
  root: ${hydra:runtime.cwd}/data
  train_dir: ${dataset.root}/train
  val_dir: ${dataset.root}/val
  test_dir: ${dataset.root}/test
  augmented_dirs: []
  test_manifest: null
  submission_output: ${hydra:runtime.cwd}/submissions/track_a.csv
  num_frames: 8
  val_ratio: 0.2
  use_official_val: true
  seed: ${seed}
  max_samples: null
  image_size: 224
  time_reversal_prob: 0.0
training:
  batch_size: 16
  lr: 0.0001
  epochs: 150
  num_workers: 2
  checkpoint_path: /Data/thomas.turkieh/smth2smth/checkpoints/track_a/trackA_randaugT_sslInit_officialVal_ep150_best_20260514.pt
  resume_from: null
  amp: false
  device: cuda
  optimizer: adam
  momentum: 0.9
  nesterov: false
  weight_decay: 1.0e-05
  scheduler_cosine: true
  warmup_epochs: 10
  min_lr: 1.0e-06
  label_smoothing: 0.1
  videomix_alpha: 5.0
  videomix_prob: 0.5
  videomix_mode: frame_mixup
  early_stopping_enabled: true
  early_stopping_patience: 20
  early_stopping_min_delta: 0.001
  log_interval_steps: 100
  ema_enabled: false
  ema_decay: 0.999
  tta: true
  tta_flip: true
  tta_temporal_shift: 0
  tta_scales:
  - 0.875
  - 1.0
  - 1.125
  tta_logit_adjust: 0.0
  class_balance_sampler: none
  class_balance_loss: none
  class_balance_beta: 0.999
augment:
  name: randaugment_t
  random_horizontal_flip: true
  random_crop: true
  crop_padding: 32
  color_jitter: false
  color_jitter_brightness: 0.0
  color_jitter_contrast: 0.0
  color_jitter_saturation: 0.0
  color_jitter_hue: 0.0
  sync_across_frames: true
  randaugment:
    enabled: true
    'n': 2
    m: 9.0
    mode: temporal_plus
    magnitude_max: 30.0
    ops: null
pretrain:
  epochs: 100
  batch_size: 64
  lr: 0.0005
  weight_decay: 0.04
  log_interval_steps: 50
  checkpoint_path: ${hydra:runtime.cwd}/ssl_trunk.pt
  max_frames: null
  image_size: 224
  local_image_size: 96
  num_local_views: 6
  out_dim: 4096
  hidden_dim: 2048
  bottleneck_dim: 256
  n_layers: 3
  teacher_temp: 0.04
  student_temp: 0.1
  center_momentum: 0.9
  teacher_momentum_base: 0.996
  teacher_momentum_final: 1.0
track:
  name: a
  description: 'Closed-world track: train from scratch.'
num_classes: 33
seed: 42

