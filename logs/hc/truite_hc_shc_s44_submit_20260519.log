model:
  name: video_mae_vit
  variant: vit_b
  num_classes: ${num_classes}
  tube_t: 1
  patch_size: 16
  mlp_ratio: 4.0
  drop_path_rate: 0.1
  dropout: 0.0
  head: attn
  head_num_heads: 4
  init_from: ${hydra:runtime.cwd}/checkpoints/track_a/ssl/sole_encoder.pt
  interpolate_pos_embed: false
  interpolate_src_image_size: 224
  interpolate_src_num_frames: ${dataset.num_frames}
  gradient_checkpointing: true
  freeze_backbone: false
  residual_variant: shc
  hc_n: 4
  hc_sk_iters: 3
  hc_sk_tau: 1.0
dataset:
  root: ${hydra:runtime.cwd}/data
  train_dir: ${dataset.root}/train
  val_dir: ${dataset.root}/val
  test_dir: ${dataset.root}/test
  augmented_dirs: []
  test_manifest: null
  submission_output: /Data/romain.poggi/smth2smth/submissions/track_a_hc_shc_s44_ft_20260519.csv
  num_frames: 4
  val_ratio: 0.2
  use_official_val: true
  include_val_in_train: false
  official_val_holdout_ratio: 0.0
  seed: ${seed}
  max_samples: null
  max_samples_per_class: null
  image_size: 224
  time_reversal_prob: 0.0
  temporal_reversal_augment:
    enabled: false
    prob: 0.5
  class_boosting:
    enabled: false
training:
  batch_size: 4
  epochs: 60
  optimizer: adamw
  lr: 0.0005
  layer_decay: 0.75
  weight_decay: 0.05
  scheduler: cosine
  scheduler_cosine: true
  warmup_epochs: 5
  min_lr: 1.0e-06
  label_smoothing: 0.1
  videomix_mode: mixup_cutmix_switch
  videomix_alpha: 1.0
  videomix_mixup_alpha: 0.8
  videomix_cutmix_alpha: 1.0
  videomix_prob: 1.0
  videomix_switch_prob: 0.5
  repeated_aug: 2
  amp: true
  amp_dtype: bf16
  ema_enabled: true
  ema_decay: 0.999
  early_stopping_enabled: true
  early_stopping_patience: 25
  early_stopping_min_delta: 0.001
  num_workers: 4
  log_interval_steps: 100
  device: cuda
  checkpoint_path: /Data/romain.poggi/smth2smth/checkpoints/track_a/hc/shc_n4_s44_ft.pt
  tta: true
  tta_flip: true
  tta_scales:
  - 1.0
  grad_accum_steps: 16
  stability_log_path: ${hydra:runtime.cwd}/logs/hc/shc_n4_s${seed}_stability.csv
  stability_log_every: 10
  stability_log_per_block: true
  stability_log_hc_drift: true
