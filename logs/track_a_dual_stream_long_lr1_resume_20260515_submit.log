  train_dir: ${dataset.root}/train
  val_dir: ${dataset.root}/val
  test_dir: ${dataset.root}/test
  augmented_dirs: []
  test_manifest: null
  submission_output: /Data/romain.poggi/smth2smth/submissions/track_a_dual_stream_long_lr1_resume_20260515.csv
