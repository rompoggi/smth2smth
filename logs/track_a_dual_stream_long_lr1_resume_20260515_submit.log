  momentum: 0.9
  nesterov: false
  weight_decay: 0.05
  scheduler_cosine: true
  warmup_epochs: 6
  min_lr: 1.0e-06
  label_smoothing: 0.1
  videomix_alpha: 5.0
  videomix_prob: 0.5
