  use_official_val: true
  seed: ${seed}
  max_samples: null
  max_samples_per_class: null
  image_size: 224
  time_reversal_prob: 0.0
  temporal_reversal_augment:
    enabled: false
    prob: 0.5
  class_boosting:
    enabled: true
training:
  batch_size: 16
  lr: 0.0001
  epochs: 80
