model:
  name: vjepa2
  pretrained: true
  num_classes: ${num_classes}
  hf_repo: facebook/vjepa2-vitl-fpc64-256
  head_type: attentive
  head_num_heads: 8
  head_num_queries: 1
  head_dropout: 0.0
  lora_enabled: true
  lora_r: 8
  lora_alpha: 16
  lora_dropout: 0.05
  lora_target_modules: null
  freeze_backbone: true
  attn_implementation: sdpa
dataset:
  root: ${hydra:runtime.cwd}/data
  train_dir: ${dataset.root}/train
  val_dir: ${dataset.root}/val
  test_dir: ${dataset.root}/test
  augmented_dirs: []
  test_manifest: null
  submission_output: ${hydra:runtime.cwd}/submissions/track_b.csv
  num_frames: 16
  val_ratio: 0.2
  use_official_val: true
  train_include_val: true
  seed: ${seed}
  max_samples: null
  max_samples_per_class: null
  image_size: 256
  time_reversal_prob: 0.0
  temporal_reversal_augment:
    enabled: false
    prob: 0.5
  class_boosting:
    enabled: false
training:
  batch_size: 4
  lr: 5.0e-05
  epochs: 23
  num_workers: 0
  checkpoint_path: checkpoints/track_b/vitl_fulltrain_lora_lowlr.pt
  resume_from: checkpoints/track_b/vitl_fulltrain_lora.pt
  lora_lr: 1.0e-05
  lora_lr_ratio: 0.25
  motion_lr: null
  motion_lr_ratio: null
  resume_apply_cfg_lr: true
  amp: true
  device: cuda
  optimizer: adamw
  momentum: 0.9
  nesterov: false
  weight_decay: 0.08
  scheduler_cosine: true
  warmup_epochs: 1
  min_lr: 1.0e-06
  label_smoothing: 0.1
  videomix_alpha: 0.0
