model:
  name: avanced_resnet50_tsm
  backbone: resnet50
  pretrained: false
  num_classes: ${num_classes}
  shift_div: 8
  shift_place: blockres
  dropout: 0.5
  drop_path_rate: 0.1
  head: attn
  head_num_heads: 4
  init_from: null
dataset:
  root: ${hydra:runtime.cwd}/data
  train_dir: ${dataset.root}/train
  val_dir: ${dataset.root}/val
  test_dir: ${dataset.root}/test
  augmented_dirs: []
  test_manifest: null
  submission_output: ${hydra:runtime.cwd}/submissions/track_a.csv
  num_frames: 4
  val_ratio: 0.2
  use_official_val: true
  include_val_in_train: true
  seed: ${seed}
  max_samples: null
  max_samples_per_class: null
  image_size: 224
  time_reversal_prob: 0.0
  temporal_reversal_augment:
    enabled: false
    prob: 0.5
  class_boosting:
    enabled: false
training:
  batch_size: 16
  lr: 1.0e-05
  epochs: 25
  num_workers: 4
  checkpoint_path: ${hydra:runtime.cwd}/checkpoints/track_a/e4_ft_trainval.pt
  resume_from: ${hydra:runtime.cwd}/checkpoints/track_a/e4_ft.pt
  lora_lr: null
  lora_lr_ratio: 0.25
  motion_lr: null
  motion_lr_ratio: null
  resume_apply_cfg_lr: true
  reset_epoch_on_resume: true
  amp: true
  device: cuda
  optimizer: adamw
  momentum: 0.9
  nesterov: false
  weight_decay: 0.01
  scheduler_cosine: true
  warmup_epochs: 3
  warmup_start_epoch: null
  min_lr: 1.0e-06
  label_smoothing: 0.1
  videomix_alpha: 5.0
  videomix_prob: 0.5
  videomix_mode: frame_mixup
  videomix_mixup_alpha: null
  videomix_cutmix_alpha: null
  videomix_switch_prob: 0.5
  layer_decay: null
  repeated_aug: 1
  grad_accum_steps: 4
  amp_dtype: float16
  scheduler: cosine
  sgdr_T0: 30
  sgdr_save_snapshots: false
  early_stopping_enabled: false
  early_stopping_patience: 10
  early_stopping_min_delta: 0.0
  log_interval_steps: 100
  ema_enabled: true
  ema_decay: 0.999
  eval_every_n_epochs: 1
  eval_ema: true
  save_last_checkpoint: true
  last_checkpoint_path: ${hydra:runtime.cwd}/checkpoints/track_a/e4_ft_trainval.last.pt
  tta: true
  tta_flip: true
  tta_temporal_shift: 0
  tta_scales:
  - 0.875
  - 1.0
  - 1.125
  tta_logit_adjust: 0.0
  class_balance_sampler: none
  class_balance_loss: none
  class_balance_beta: 0.999
augment:
  name: randaugment_t
  random_horizontal_flip: true
  random_crop: true
  crop_padding: 32
  color_jitter: false
  color_jitter_brightness: 0.0
  color_jitter_contrast: 0.0
  color_jitter_saturation: 0.0
  color_jitter_hue: 0.0
  sync_across_frames: true
  random_grayscale: false
  random_grayscale_prob: 0.0
  gaussian_blur: false
  gaussian_blur_prob: 0.0
  gaussian_blur_radius_min: 0.1
  gaussian_blur_radius_max: 2.0
  randaugment:
    enabled: true
    'n': 2
    m: 9.0
    mode: temporal_plus
    magnitude_max: 30.0
    ops: null
pretrain:
  epochs: 100
  batch_size: 64
  lr: 0.0005
  weight_decay: 0.04
  log_interval_steps: 50
  checkpoint_path: ${hydra:runtime.cwd}/ssl_trunk.pt
  max_frames: null
  image_size: 224
  local_image_size: 96
  num_local_views: 6
  out_dim: 4096
  hidden_dim: 2048
  bottleneck_dim: 256
  n_layers: 3
  teacher_temp: 0.04
  student_temp: 0.1
  center_momentum: 0.9
  teacher_momentum_base: 0.996
  teacher_momentum_final: 1.0
track:
  name: a
  description: 'Closed-world track: train from scratch.'
seed: 42
num_classes: 33

