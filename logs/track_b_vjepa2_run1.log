model:
  name: vjepa2
  pretrained: true
  num_classes: ${num_classes}
  hf_repo: facebook/vjepa2-vitl-fpc16-256-ssv2
  head_type: attentive
  head_num_heads: 8
  head_dropout: 0.1
  freeze_backbone: true
  attn_implementation: sdpa
dataset:
  root: ${hydra:runtime.cwd}/data
  train_dir: ${dataset.root}/train
  val_dir: ${dataset.root}/val
  test_dir: ${dataset.root}/test
  augmented_dirs: []
  test_manifest: null
  submission_output: ${hydra:runtime.cwd}/submissions/track_b.csv
  num_frames: 16
  val_ratio: 0.2
  use_official_val: true
  seed: ${seed}
  max_samples: null
  max_samples_per_class: 200
  image_size: 256
training:
  batch_size: 8
  lr: 0.0005
  epochs: 15
  num_workers: 4
  checkpoint_path: ${hydra:runtime.cwd}/checkpoints/track_b/vjepa2_heavy_aug.pt
  resume_from: null
  amp: true
  device: cuda
  optimizer: adamw
  momentum: 0.9
  nesterov: false
  weight_decay: 0.05
  scheduler_cosine: true
  warmup_epochs: 2
  min_lr: 5.0e-06
  label_smoothing: 0.1
  videomix_alpha: 1.0
  videomix_prob: 0.5
  videomix_mode: cube_cutmix
  early_stopping_enabled: true
  early_stopping_patience: 8
  early_stopping_min_delta: 0.001
  log_interval_steps: 50
  ema_enabled: false
  ema_decay: 0.999
  tta: true
  tta_flip: true
  tta_temporal_shift: 0
augment:
  name: vjepa2_heavy
  random_horizontal_flip: true
  random_crop: true
  crop_padding: 32
  color_jitter: true
  color_jitter_brightness: 0.3
  color_jitter_contrast: 0.3
  color_jitter_saturation: 0.3
  color_jitter_hue: 0.05
  sync_across_frames: true
  randaugment:
    enabled: true
    'n': 2
    m: 9.0
    mode: temporal_plus
    magnitude_max: 30.0
    ops: null
pretrain:
  epochs: 100
  batch_size: 64
  lr: 0.0005
  weight_decay: 0.04
  log_interval_steps: 50
  checkpoint_path: ${hydra:runtime.cwd}/ssl_trunk.pt
  max_frames: null
  image_size: 224
  local_image_size: 96
  num_local_views: 6
  out_dim: 4096
  hidden_dim: 2048
  bottleneck_dim: 256
  n_layers: 3
  teacher_temp: 0.04
  student_temp: 0.1
  center_momentum: 0.9
  teacher_momentum_base: 0.996
  teacher_momentum_final: 1.0
track:
  name: b
  description: 'Open-world track: pretrained backbone allowed.'
num_classes: 33
seed: 42

