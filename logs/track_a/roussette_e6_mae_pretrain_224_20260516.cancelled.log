model:
  name: video_mae_vit
  variant: vit_s
  num_classes: ${num_classes}
  tube_t: 2
  patch_size: 16
  mlp_ratio: 4.0
  drop_path_rate: 0.0
  dropout: 0.0
  head: mean
  head_num_heads: 4
  init_from: null
  interpolate_pos_embed: false
  interpolate_src_image_size: 224
  interpolate_src_num_frames: ${dataset.num_frames}
  gradient_checkpointing: false
  freeze_backbone: false
dataset:
  root: ${hydra:runtime.cwd}/data
  train_dir: ${dataset.root}/train
  val_dir: ${dataset.root}/val
  test_dir: ${dataset.root}/test
  augmented_dirs: []
  test_manifest: null
  submission_output: ${hydra:runtime.cwd}/submissions/track_a.csv
  num_frames: 8
  val_ratio: 0.2
  use_official_val: false
  include_val_in_train: false
  seed: ${seed}
  max_samples: null
  max_samples_per_class: null
  image_size: 224
  time_reversal_prob: 0.0
  temporal_reversal_augment:
    enabled: false
    prob: 0.5
  class_boosting:
    enabled: false
training:
  batch_size: 16
  lr: 0.0001
  epochs: 5
  num_workers: 4
  checkpoint_path: ${hydra:runtime.cwd}/checkpoints/track_a/best_model.pt
  resume_from: null
  lora_lr: null
  lora_lr_ratio: 0.25
  motion_lr: null
  motion_lr_ratio: null
  resume_apply_cfg_lr: false
  amp: true
  device: cuda
  optimizer: adam
  momentum: 0.9
  nesterov: false
  weight_decay: 0.0
  scheduler_cosine: false
  warmup_epochs: 0
  min_lr: 0.0
  label_smoothing: 0.0
  videomix_alpha: 0.0
  videomix_prob: 1.0
  videomix_mode: cube_cutmix
  videomix_mixup_alpha: null
  videomix_cutmix_alpha: null
  videomix_switch_prob: 0.5
  layer_decay: null
  repeated_aug: 1
  grad_accum_steps: 1
  amp_dtype: float16
  scheduler: none
  sgdr_T0: 30
  sgdr_save_snapshots: false
  early_stopping_enabled: false
  early_stopping_patience: 10
  early_stopping_min_delta: 0.0
  log_interval_steps: 0
  ema_enabled: false
  ema_decay: 0.999
  eval_every_n_epochs: 1
  eval_ema: true
  save_last_checkpoint: true
  last_checkpoint_path: null
  tta: true
  tta_flip: true
  tta_temporal_shift: 0
  tta_scales:
  - 0.875
  - 1.0
  - 1.125
  tta_logit_adjust: 0.0
  class_balance_sampler: none
  class_balance_loss: none
  class_balance_beta: 0.999
augment:
  name: none
  random_horizontal_flip: false
  random_crop: true
  crop_padding: 32
  color_jitter: false
  color_jitter_brightness: 0.0
  color_jitter_contrast: 0.0
  color_jitter_saturation: 0.0
  color_jitter_hue: 0.0
  random_grayscale: false
  random_grayscale_prob: 0.0
  gaussian_blur: false
  gaussian_blur_prob: 0.0
  gaussian_blur_radius_min: 0.1
  gaussian_blur_radius_max: 2.0
pretrain:
  epochs: 100
  warmup_epochs: 5
  batch_size: 16
  lr: 0.00015
  weight_decay: 0.05
  min_lr: 0.0
  mask_ratio: 0.75
  norm_pix: true
  norm_feat: true
  drop_path_rate: 0.0
  tube_t: 2
  patch_size: 16
  checkpoint_path: ${hydra:runtime.cwd}/checkpoints/track_a/ssl/e6_encoder.pt
  max_videos: null
  image_size: 224
  num_frames: 4
  log_interval_steps: 100
  include_val_in_pretrain: false
  mask_ratio_schedule: false
  mask_ratio_start: 0.9
  mask_ratio_end: 0.75
  grad_accum_steps: 1
track:
  name: a
  description: 'Closed-world track: train from scratch.'
seed: 42
num_classes: 33

