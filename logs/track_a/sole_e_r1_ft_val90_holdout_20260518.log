model:
  name: video_mae_vit
  variant: vit_b
  num_classes: ${num_classes}
  tube_t: 1
  patch_size: 16
  mlp_ratio: 4.0
  drop_path_rate: 0.1
  dropout: 0.0
  head: attn
  head_num_heads: 4
  init_from: null
  interpolate_pos_embed: false
  interpolate_src_image_size: 224
  interpolate_src_num_frames: ${dataset.num_frames}
  gradient_checkpointing: true
  freeze_backbone: false
  residual_variant: prenorm
  hc_n: 4
  hc_sk_iters: 3
  hc_sk_tau: 1.0
dataset:
  root: ${hydra:runtime.cwd}/data
  train_dir: ${dataset.root}/train
  val_dir: ${dataset.root}/val
  test_dir: ${dataset.root}/test
  augmented_dirs: []
  test_manifest: null
  submission_output: ${hydra:runtime.cwd}/submissions/track_a.csv
  num_frames: 4
  val_ratio: 0.2
  use_official_val: true
  include_val_in_train: false
  official_val_holdout_ratio: 0.1
  seed: ${seed}
  max_samples: null
  max_samples_per_class: null
  image_size: 224
  time_reversal_prob: 0.0
  temporal_reversal_augment:
    enabled: false
    prob: 0.5
  class_boosting:
    enabled: false
training:
  batch_size: 24
  epochs: 10
  optimizer: adamw
  lr: 5.0e-05
  layer_decay: 0.75
  weight_decay: 0.05
  scheduler: cosine
  scheduler_cosine: true
  warmup_epochs: 2
  min_lr: 1.0e-06
  label_smoothing: 0.1
  videomix_mode: mixup_cutmix_switch
  videomix_alpha: 1.0
  videomix_mixup_alpha: 0.8
  videomix_cutmix_alpha: 1.0
  videomix_prob: 1.0
  videomix_switch_prob: 0.5
  repeated_aug: 2
  amp: true
  amp_dtype: bf16
  ema_enabled: true
  ema_decay: 0.999
  early_stopping_enabled: true
  early_stopping_patience: 4
  early_stopping_min_delta: 0.001
  num_workers: 4
  log_interval_steps: 100
  device: cuda
  checkpoint_path: ${hydra:runtime.cwd}/checkpoints/track_a/ssl/e_r1_ft_val90_holdout.pt
  tta: true
  tta_flip: true
  tta_scales:
  - 0.857
  - 1.0
  - 1.143
  grad_accum_steps: 2
  resume_from: ${hydra:runtime.cwd}/checkpoints/track_a/ssl/e_r1_ft.pt
  resume_apply_cfg_lr: true
augment:
  name: champion_ft
  random_horizontal_flip: true
  random_horizontal_flip_prob: 0.5
  random_crop: true
  crop_padding: 32
  color_jitter: false
  sync_across_frames: true
  randaugment:
    enabled: true
    'n': 2
    m: 9.0
    mode: temporal_plus
    magnitude_max: 30.0
    ops: null
pretrain:
  epochs: 100
  batch_size: 64
  lr: 0.0005
  weight_decay: 0.04
  log_interval_steps: 50
  checkpoint_path: ${hydra:runtime.cwd}/ssl_trunk.pt
  max_frames: null
  image_size: 224
  local_image_size: 96
  num_local_views: 6
  out_dim: 4096
  hidden_dim: 2048
  bottleneck_dim: 256
  n_layers: 3
  teacher_temp: 0.04
  student_temp: 0.1
  center_momentum: 0.9
  teacher_momentum_base: 0.996
  teacher_momentum_final: 1.0
track:
  name: a
  description: 'Closed-world track: train from scratch.'
seed: 42
num_classes: 33

