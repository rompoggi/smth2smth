model:
  name: cnn_baseline
  pretrained: true
  num_classes: ${num_classes}
dataset:
  root: ${hydra:runtime.cwd}/data
  train_dir: ${dataset.root}/train
  val_dir: ${dataset.root}/val
  test_dir: ${dataset.root}/test
  augmented_dirs: []
  test_manifest: null
  submission_output: submissions/track_b_vitg384_continue_20260512_1322.csv
  num_frames: 8
  val_ratio: 0.2
  use_official_val: false
  seed: ${seed}
  max_samples: null
  max_samples_per_class: null
  image_size: 384
training:
  batch_size: 4
  lr: 0.0001
  epochs: 5
  num_workers: 2
  checkpoint_path: checkpoints/track_b/vitg384_heavy_aug.pt
  resume_from: null
  amp: true
  device: cuda
  optimizer: adam
  momentum: 0.9
  nesterov: false
  weight_decay: 0.0
  scheduler_cosine: false
  warmup_epochs: 0
  min_lr: 0.0
  label_smoothing: 0.0
  videomix_alpha: 0.0
  videomix_prob: 1.0
  videomix_mode: cube_cutmix
  early_stopping_enabled: false
  early_stopping_patience: 10
  early_stopping_min_delta: 0.0
  log_interval_steps: 0
  ema_enabled: false
  ema_decay: 0.999
  eval_every_n_epochs: 1
  eval_ema: true
  save_last_checkpoint: true
  last_checkpoint_path: null
  tta: true
  tta_flip: true
  tta_temporal_shift: 0
augment:
  name: none
  random_horizontal_flip: true
  random_crop: false
  crop_padding: 0
  color_jitter: false
  color_jitter_brightness: 0.0
  color_jitter_contrast: 0.0
  color_jitter_saturation: 0.0
  color_jitter_hue: 0.0
pretrain:
  epochs: 100
  batch_size: 64
  lr: 0.0005
  weight_decay: 0.04
  log_interval_steps: 50
  checkpoint_path: ${hydra:runtime.cwd}/ssl_trunk.pt
  max_frames: null
  image_size: 224
  local_image_size: 96
  num_local_views: 6
  out_dim: 4096
  hidden_dim: 2048
  bottleneck_dim: 256
  n_layers: 3
  teacher_temp: 0.04
  student_temp: 0.1
  center_momentum: 0.9
  teacher_momentum_base: 0.996
  teacher_momentum_final: 1.0
track:
  name: b
  description: 'Open-world track: pretrained backbone allowed.'
num_classes: 33
seed: 42

