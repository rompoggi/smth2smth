nohup: ignoring input
model:
  name: avanced_resnet50_tsm
  backbone: resnet50
  pretrained: false
  num_classes: ${num_classes}
  shift_div: 8
  shift_place: blockres
  dropout: 0.5
  drop_path_rate: 0.0
  head: mean
  head_num_heads: 4
  init_from: null
dataset:
  root: ${hydra:runtime.cwd}/data
  train_dir: ${dataset.root}/train
  val_dir: ${dataset.root}/val
  test_dir: ${dataset.root}/test
  augmented_dirs: []
  test_manifest: null
  submission_output: ${hydra:runtime.cwd}/submissions/track_a.csv
  num_frames: 8
  val_ratio: 0.2
  use_official_val: false
  seed: ${seed}
  max_samples: null
  image_size: 224
  time_reversal_prob: 0.0
training:
  batch_size: 32
  lr: 0.0001
  epochs: 5
  num_workers: 2
  checkpoint_path: ${hydra:runtime.cwd}/checkpoints/track_a/best_model.pt
  resume_from: null
  amp: true
  device: cuda
  optimizer: adam
  momentum: 0.9
  nesterov: false
  weight_decay: 0.0
  scheduler_cosine: false
  warmup_epochs: 0
  min_lr: 0.0
  label_smoothing: 0.0
  videomix_alpha: 0.0
  videomix_prob: 1.0
  videomix_mode: cube_cutmix
  early_stopping_enabled: false
  early_stopping_patience: 10
  early_stopping_min_delta: 0.0
  log_interval_steps: 0
  ema_enabled: false
  ema_decay: 0.999
  tta: false
  tta_flip: true
  tta_temporal_shift: 0
  tta_scales: null
  tta_logit_adjust: 0.0
  class_balance_sampler: none
  class_balance_loss: none
  class_balance_beta: 0.999
augment:
  name: randaugment_t
  random_horizontal_flip: true
  random_crop: true
  crop_padding: 32
  color_jitter: false
  color_jitter_brightness: 0.0
  color_jitter_contrast: 0.0
  color_jitter_saturation: 0.0
  color_jitter_hue: 0.0
  sync_across_frames: true
  randaugment:
    enabled: true
    'n': 2
    m: 5.0
    mode: temporal_plus
    magnitude_max: 30.0
    ops: null
pretrain:
  epochs: 50
  batch_size: 32
  lr: 0.0005
  weight_decay: 0.04
  log_interval_steps: 100
  checkpoint_path: /Data/thomas.turkieh/smth2smth/vjepa_trunk.pt
  max_videos: null
  image_size: 224
  num_frames: 4
  mask_prob: 0.5
  min_mask: 1
  max_mask: 2
  predictor_hidden_dim: 2048
  teacher_momentum_base: 0.996
  teacher_momentum_final: 1.0
track:
  name: a
  description: 'Closed-world track: train from scratch.'
num_classes: 33
seed: 42

